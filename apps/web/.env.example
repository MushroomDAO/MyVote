# ---------------------------------------------------------------------------
# Snapshot
# ---------------------------------------------------------------------------

# Snapshot Hub. Votes are signed for this hub and submitted to its sequencer.
#
# IMPORTANT: a space whose network is a testnet (e.g. Sepolia) only exists on the
# *testnet* hub — the mainnet hub will reject its votes. Point this at the hub
# that actually hosts your space.
#   testnet: https://testnet.hub.snapshot.org   (default)
#   mainnet: https://hub.snapshot.org
VITE_SNAPSHOT_HUB=https://testnet.hub.snapshot.org

# Snapshot Hub GraphQL endpoint.
# Defaults to ${VITE_SNAPSHOT_HUB}/graphql — set only to override.
# VITE_SNAPSHOT_GRAPHQL_ENDPOINT=https://testnet.hub.snapshot.org/graphql

# App identifier sent with every vote. Change it to track votes from your deployment.
# Default: myvote
VITE_SNAPSHOT_APP_NAME=myvote

# ---------------------------------------------------------------------------
# AirAccount / cos72 SSO
# ---------------------------------------------------------------------------

# cos72 backend origin (scheme + host, NO trailing slash and NO path).
# The SSO endpoints are called at ${VITE_COS72_API}/api/v1/sso/{exchange,verify}.
# Required for AirAccount login; unset means AirAccount login raises a config error.
VITE_COS72_API=https://api.cos72.example

# AirAccount-only deployment: hides the wallet provider and makes AirAccount the
# default. Leave unset (or anything but "true") to keep the wallet option.
# Note: the wallet option also disappears automatically while an SSO session is live.
# VITE_SSO_ONLY=true
